{
  "name": "@zcag/pal",
  "version": "0.1.0",
  "description": "The extension API of pal, a keyboard launcher: the types an extension implements and the calls it makes.",
  "license": "MIT",
  "author": "Cagdas Salur",
  "repository": { "type": "git", "url": "git+https://github.com/zcag/pal.git", "directory": "sdk" },
  "homepage": "https://github.com/zcag/pal/blob/main/docs/extensions.md",
  "keywords": ["pal", "launcher", "extension", "palette"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./runtime": { "types": "./src/runtime.ts", "default": "./src/runtime.ts" }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "engines": { "bun": ">=1.2" },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "~6.0.3"
  }
}
