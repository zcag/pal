  "shots": {
    "1-list": {
      "palette": "menu-bar",
      "keys": [
        "down*3"
      ],
      "caption": "TextEdit's menus in one list: a section per menu, the path as the subtitle, shortcuts as key caps"
    },
    "2-checked": {
      "palette": "menu-bar",
      "keys": [
        "down*38"
      ],
      "caption": "A checked item carries its mark; Enter Full Screen shows its Globe key"
    },
    "3-search": {
      "palette": "menu-bar",
      "keys": [
        "type:font"
      ],
      "caption": "Typing narrows by the whole path: font finds every Format > Font item"
    },
    "4-root": {
      "keys": [
        "type:export"
      ],
      "caption": "The rows are root results too: export from the root, no palette first"
    }
  }
}
