  "effects": {
    "make/build@~/code/api:makefile": {
      "show": {
        "title": "Makefile in ~/code/api",
        "markdown": "````make\n.PHONY: build test lint run migrate docker clean\n\n## Compile the server into bin/api\nbuild:\n\tgo build -o bin/api ./cmd/api\n\n## Run every test with the race detector\ntest:\n\tgo test -race ./...\n\nlint: ## Vet and staticcheck\n\tgo vet ./...\n\tstaticcheck ./...\n\n## Start the server on :8080 with the dev config\nrun: build\n\t./bin/api --config config/dev.toml\n\n## Apply pending database migrations\nmigrate:\n\tmigrate -path db/migrations -database \"$$DATABASE_URL\" up\n\ndocker: ## Build the image tagged with the git sha\n\tdocker build -t ghcr.io/acme/api:$$(git rev-parse --short HEAD) .\n\nclean:\n\trm -rf bin/\n````"
      }
    }
  },
  "shots": {
    "1-targets": {
      "palette": "make",
      "keys": [
        "wait:1500",
        "down"
      ],
      "caption": "Every target of the Makefiles under the configured folders, a section per project, its ## description under the name"
    },
    "2-recipe": {
      "palette": "make",
      "keys": [
        "wait:1500",
        "down*2",
        "cmd+i",
        "wait:400"
      ],
      "caption": "The detail pane (cmd+I): the Makefile and the target on top, its description, then its recipe"
    },
    "3-makefile": {
      "palette": "make",
      "keys": [
        "wait:1500",
        "cmd+l"
      ],
      "caption": "Show Makefile (cmd+L): the whole file in the panel, the ## comments that describe the targets included"
    },
    "4-actions": {
      "palette": "make",
      "keys": [
        "wait:1500",
        "down*5",
        "cmd+k"
      ],
      "caption": "What a target can do: run it, copy the make command, open the project, show the Makefile"
    }
  }
