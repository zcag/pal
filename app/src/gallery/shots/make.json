      "keys": [
        "wait:1500",
        "down*2",
        "cmd+i",
        "wait:400"
      ],
      "caption": "The detail pane (cmd+I): the target's recipe, then its project, its Makefile and its description"
    },
    "3-makefile": {
      "palette": "make",
      "keys": [
        "wait:1500",
        "cmd+l"
      ],
      "caption": "Show Makefile (cmd+L): the whole file in the panel, the ## comments that describe the targets included"
    },
    "4-actions": {
      "palette": "make",
      "keys": [
        "wait:1500",
        "down*5",
        "cmd+k"
      ],
      "caption": "What a target can do: run it, copy the make command, open the project, show the Makefile"
    }
  }
