        "title": "New timer",
        "fields": [
          {
            "kind": "text",
            "id": "duration",
            "label": "Duration",
            "placeholder": "25m, 90s, 1h30m, 2:30, 25",
            "required": true,
            "description": "A bare number is minutes."
          },
          {
            "kind": "text",
            "id": "name",
            "label": "Name",
            "placeholder": "tea",
            "description": "Optional; the duration otherwise. A name already taken restarts that timer."
          },
          {
            "kind": "checkbox",
            "id": "ring",
            "label": "Phone",
            "text": "Ring the phone out loud when it lands"
          }
        ],
