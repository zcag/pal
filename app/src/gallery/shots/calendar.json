  "effects": {
    "schedule/new": {
      "form": {
        "id": "new",
        "title": "New event",
        "fields": [
          {
            "kind": "text",
            "id": "title",
            "label": "Title",
            "required": true,
            "default": "",
            "placeholder": "Dentist"
          },
          {
            "kind": "text",
            "id": "day",
            "label": "Day",
            "default": "today",
            "placeholder": "today",
            "description": "today, tomorrow, fri, next mon, 2026-09-20, 20 sep"
          },
          {
            "kind": "text",
            "id": "start",
            "label": "Start",
            "default": "14:45",
            "placeholder": "14:30",
            "description": "14:30, 2pm, 1430; ignored for an all-day event"
          },
          {
            "kind": "text",
            "id": "end",
            "label": "End",
            "default": "15:45",
            "placeholder": "15:30",
            "description": "A time, or a day for an all-day event (its last day)"
          },
          {
            "kind": "checkbox",
            "id": "all_day",
            "label": "All day",
            "text": "The whole day, no times",
            "default": false
          },
          {
            "kind": "select",
            "id": "calendar",
            "label": "Calendar",
            "options": [
              {
                "id": "",
                "title": "Default calendar"
              },
              {
                "id": "work",
                "title": "Work (iCloud)"
              },
              {
                "id": "home",
                "title": "Home (iCloud)"
              },
              {
                "id": "team",
                "title": "Team (Google)"
              }
            ],
            "default": ""
          },
          {
            "kind": "text",
            "id": "location",
            "label": "Location",
            "default": "",
            "placeholder": "Room 4, or a meeting link"
          },
          {
            "kind": "textarea",
            "id": "notes",
            "label": "Notes",
            "default": ""
          }
        ],
        "submit": {
          "id": "create",
          "title": "Add event"
        }
      }
    }
