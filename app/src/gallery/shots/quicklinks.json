  "effects": {
    "quicklinks/l1": {
      "push": {
        "extension": "",
        "palette": "quicklinks",
        "args": "gh"
      }
    },
    "quicklinks/create": {
      "form": {
        "id": "create",
        "title": "Create Quicklink",
        "fields": [
          {
            "kind": "text",
            "id": "name",
            "label": "Name",
            "required": true,
            "placeholder": "GitHub search"
          },
          {
            "kind": "text",
            "id": "url",
            "label": "URL",
            "required": true,
            "placeholder": "https://github.com/search?q={query}",
            "description": "{query} stands for what you type when opening it."
          },
          {
            "kind": "text",
            "id": "keywords",
            "label": "Keywords",
            "placeholder": "gh code",
            "description": "Extra words that find it, space separated."
          }
        ],
        "submit": {
          "id": "save",
          "title": "Create"
        }
      }
    }
  },
  "shots": {
    "1-list": {
      "palette": "quicklinks",
      "keys": [
        "down"
      ]
    },
    "2-query": {
      "palette": "quicklinks",
      "keys": [
        "down",
        "enter",
        "wait:300",
        "type:rust async"
      ]
    },
    "3-actions": {
      "palette": "quicklinks",
      "keys": [
        "down*3",
        "cmd+k"
      ]
    },
    "4-form": {
      "palette": "quicklinks",
      "keys": [
        "enter"
      ]
    }
  }
