  "shots": {
    "1-hosts": {
      "palette": "ssh",
      "keys": [
        "down*2"
      ],
      "caption": "Hosts sectioned by the file they came from, user@host under each name, the port and a jump host as tags"
    },
    "2-search": {
      "keys": [
        "type:example"
      ],
      "caption": "From the root, a host's real name finds its alias: example finds the four hosts under example.com"
    },
    "3-actions": {
      "palette": "ssh",
      "keys": [
        "down*2",
        "cmd+k"
      ],
      "caption": "Connect on Enter; copy the host, the ssh command or its -J form through the jump host; ping"
    },
    "4-ping": {
      "palette": "ssh",
      "keys": [
        "cmd+p",
        "wait:300"
      ],
      "caption": "Ping sends one echo and shows the round trip as a toast"
    },
    "5-detail": {
      "palette": "ssh",
      "keys": [
        "down*2",
        "cmd+i",
        "wait:400"
      ],
      "caption": "A host's detail (cmd+I): its name and file on top, the jump host as a chip, the ssh command, then HostName, User and Port"
    }
