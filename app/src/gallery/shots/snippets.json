  "effects": {
    "snippets/create": {
      "form": {
        "id": "create",
        "title": "Create Snippet",
        "fields": [
          {
            "kind": "text",
            "id": "name",
            "label": "Name",
            "required": true,
            "placeholder": "Email signature"
          },
          {
            "kind": "text",
            "id": "keyword",
            "label": "Keyword",
            "placeholder": "sig",
            "description": "One word that finds it."
          },
          {
            "kind": "textarea",
            "id": "text",
            "label": "Text",
            "required": true,
            "placeholder": "Best,\nAda",
            "description": "Filled in when pasted: {clipboard}, {selection}, {files}, {date}, {time}, {datetime}, {uuid}, {snippet name=…}; {cursor} places the caret."
          }
        ],
        "submit": {
          "id": "save",
          "title": "Create"
        }
      }
    }
  },
  "shots": {
    "1-list": {
      "palette": "snippets",
      "keys": [
        "wait:1500",
        "down"
      ],
      "caption": "Snippets by name, the keyword as a tag, the first line as the subtitle; dynamic ones (braces) fill placeholders when pasted",
      "settle": 900
    },
    "2-detail": {
      "palette": "snippets",
      "keys": [
        "wait:1500",
        "down*3",
        "cmd+i"
      ],
      "caption": "cmd+i shows the whole text under its name, the keyword and dynamic as chips",
      "settle": 900
    },
    "3-actions": {
      "palette": "snippets",
      "keys": [
        "wait:1500",
        "down",
        "cmd+k"
      ],
      "caption": "Paste into the app in front, copy, edit or delete a snippet",
      "settle": 900
    },
    "4-form": {
      "palette": "snippets",
      "keys": [
        "wait:1500",
        "enter"
      ],
      "caption": "Create Snippet: a name, a keyword and the text, its placeholders explained under the field",
      "settle": 900
    }
  }
