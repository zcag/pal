  "effects": {
    "snippets/create": {
      "form": {
        "id": "create",
        "title": "Create Snippet",
        "fields": [
          {
            "kind": "text",
            "id": "name",
            "label": "Name",
            "required": true,
            "placeholder": "Email signature"
          },
          {
            "kind": "text",
            "id": "keyword",
            "label": "Keyword",
            "placeholder": "sig",
            "description": "One word that finds it."
          },
          {
            "kind": "textarea",
            "id": "text",
            "label": "Text",
            "required": true,
            "placeholder": "Best,\nAda",
            "description": "{clipboard}, {selection} (the text selected in the app in front), {date}, {time}, {datetime} and {uuid} are filled in when pasted. {cursor} places the caret when a keyword expands as you type (macOS, the Expand setting); a paste from here leaves it out."
          }
        ],
        "submit": {
          "id": "save",
          "title": "Create"
        }
      }
    }
  },
