<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged into the generated Info.plist by tauri-bundler. No Dock icon,
       no menu bar: pal is a panel over whatever is in front (the app also
       sets ActivationPolicy::Accessory at runtime). -->
  <key>LSUIElement</key>
  <true/>
  <!-- The Calendars prompt (pal_core::calendar::request): TCC shows this
       text in the dialog and, without the key, ends the process instead of
       asking. Full access (macOS 14+); the older read/write prompt reads
       NSCalendarsUsageDescription, kept for macOS 13. -->
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>pal lists your upcoming events in My Schedule and can add or remove one from the panel.</string>
  <key>NSCalendarsUsageDescription</key>
  <string>pal lists your upcoming events in My Schedule and can add or remove one from the panel.</string>
  <!-- The Location Services prompt (permissions.rs, `location`): macOS 15+
       shows Wi-Fi network names only to an app with it. Asked the first
       time the Wi-Fi palette lists with the names withheld. Same text under
       the pre-11 key, which older readers of the plist look for. -->
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>pal reads the names of Wi-Fi networks; macOS only shows them to apps with Location access.</string>
  <key>NSLocationUsageDescription</key>
  <string>pal reads the names of Wi-Fi networks; macOS only shows them to apps with Location access.</string>
</dict>
</plist>
