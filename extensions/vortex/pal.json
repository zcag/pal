  "store": {
    "tagline": "Slip through the closing walls, on the beat",
    "category": "fun",
    "play": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "actions": [
      {
        "title": "Turn",
        "description": "Round the centre, either way; A and D too. Hold Shift to turn slowly for a fine line.",
        "keys": "left, right"
      },
      {
        "title": "Play, or play again",
        "description": "After a death the next run is one key away.",
        "keys": "space"
      },
      {
        "title": "Choose a stage",
        "description": "Left and right on the stages; up for a stage's hyper once you've cleared it.",
        "keys": "left, right, up"
      },
      {
        "title": "Practice",
        "description": "On a stage: start from a rank you've reached there.",
        "keys": "p"
      },
      {
        "title": "Your look",
        "description": "The player's shape and trail, opened by medals; the ghost on or off.",
        "keys": "c"
      },
      {
        "title": "Back to the stages",
        "keys": "backspace"
      },
      {
        "title": "Sound on or off",
        "keys": "m"
      }
    ],
    "features": [
      "Walls close in on the centre with one way through; turn to the gap before they reach you, while the world spins, reverses and changes shape",
      "Six stages written to their songs: walls land on the beat, builds tighten and go dark, every drop hits with a slam on its downbeat",
      "Each stage its own world: neon, a nebula, glass, deep water, acid speed, a black hole; and a hyper of each, faster and in other colours",
      "Race the ghost of your best run, see what killed you again in slow motion, hear every near miss",
      "Medals for clearing, for a steady hand and for near misses, which open new shapes and trails for the player",
      "Endless (every stage in turn, then their hypers), a daily run with the same walls for everyone, and practice from any rank you've reached",
      "A leaderboard for every stage and its hyper, Endless and the daily; signed in, your bests, medals and looks follow you to your other machines and play.cagdas.io"
    ],
    "screenshots": [
      {
        "file": "1-pulse.png",
        "caption": "Pulse: a neon grid far below, walls that read at a glance, and you, racing a minute against the song"
      },
      {
        "file": "2-undertow.png",
        "caption": "Undertow: caustics and bubbles under a half-time song, the moment a record falls"
      },
      {
        "file": "3-singularity.png",
        "caption": "Singularity in hyper: a black hole at the centre, the last stage, faster"
      },
      {
        "file": "4-over.png",
        "caption": "A death replays slowly with the wall that got you outlined; the card says how close the record and the next rank were"
      },
      {
        "file": "5-title.png",
        "caption": "The stages, each playing itself behind its card: your best, its rank, your medals, practice from a rank you reached"
      },
      {
        "file": "6-look.png",
        "caption": "Medals open new shapes and trails for the player; the ghost of your best run, on or off"
      }
    ]
  },
